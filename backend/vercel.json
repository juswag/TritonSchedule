{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "src/app.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/seats/poll",
      "schedule": "0 18 * * *"
    }
  ]
}
